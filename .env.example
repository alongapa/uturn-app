# Copia este archivo a .env y completa con las credenciales de tu proyecto Supabase.
# Las variables EXPO_PUBLIC_ son visibles en el cliente (es correcto para la anon key).

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Mientras estas variables NO estén definidas, la app sigue funcionando con datos
# mock en memoria (store/appState). Al definirlas, se activa el backend real.
