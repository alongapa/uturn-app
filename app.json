{
  "expo": {
    "name": "Unities",
    "slug": "unities",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/unities-icon-1024.png",
    "scheme": "unities",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gapa.unities",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Unities usa tu ubicación para encontrar viajes que pasen cerca tuyo y sugerir un punto de encuentro seguro. Solo mientras usas la app.",
        "NSCameraUsageDescription": "Para tomar la foto de tu perfil y la de tu credencial universitaria cuando verificas tu cuenta.",
        "NSPhotoLibraryUsageDescription": "Para elegir tu foto de perfil y adjuntar imágenes a tus publicaciones y mensajes."
      }
    },
    "android": {
      "package": "com.gapa.unities",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0A1525",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1525"
    },
    "plugins": [
      "expo-router",
      "@sentry/react-native",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#246BFD"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A1525",
          "dark": {
            "backgroundColor": "#0A1525"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "router": {},
      "eas": {
        "projectId": "a3cbd414-0f7f-468d-95fc-625653715754"
      }
    },
    "owner": "gapa",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a3cbd414-0f7f-468d-95fc-625653715754"
    }
  }
}
